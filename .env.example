# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.
PORT=3000
HOST=127.0.0.1
DB_PATH=data/tdah.sqlite
# PROTOCOLO_PATH=protocol/protocolo.provisional.json

# Token de acceso a la API (recomendado fuera de la máquina local)
# APP_ACCESS_TOKEN=

# IA opcional: interpreta respuestas libres y extrae el informe escolar.
# Sin clave, el sistema funciona completo con el intérprete de reglas.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# IA_TIMEOUT_MS=20000
