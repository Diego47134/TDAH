# Variables para Hostinger (Environment variables → Import .env).
# Complete los valores en una COPIA de este archivo; nunca suba valores reales al repositorio.

# Obligatoria: token de acceso (mínimo 16 caracteres aleatorios; p. ej. `openssl rand -base64 24`)
APP_ACCESS_TOKEN=

# Opcional: IA para interpretar respuestas libres y extraer el informe escolar
# ANTHROPIC_API_KEY=
