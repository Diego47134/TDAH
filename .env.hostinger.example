# Variables para Hostinger (Environment variables → Import .env).
# Complete los valores en una COPIA de este archivo; nunca suba valores reales al repositorio.

# Opcional: clave fija de acceso. Si no se define, la app pide crearla en el primer ingreso.
# APP_ACCESS_TOKEN=

# Datos del responsable del tratamiento (aparecen en /privacidad.html y /terminos.html)
# RESPONSABLE_NOMBRE=
# RESPONSABLE_RUT=
# RESPONSABLE_DOMICILIO=
# RESPONSABLE_CORREO=
